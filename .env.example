# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# EMAIL NOTIFICATION SERVICE CONFIGURATION
# Set EMAIL_PROVIDER to: SENDGRID, MAILGUN, SMTP, or SIMULATED
EMAIL_PROVIDER=SIMULATED
EMAIL_API_KEY=your_sendgrid_or_mailgun_api_key
MAILGUN_DOMAIN=mg.fizzycloud.host
SENDER_EMAIL=noreply@fizzycloud.host
SENDER_NAME=Fizzy Cloud Hosting
ADMIN_NOTIFICATION_EMAIL=admin@fizzycloud.host
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

